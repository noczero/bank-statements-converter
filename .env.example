# Password for Mandiri bank statements (used by MandiriBankStatementConverter)
MANDIRI_BANK_STATEMENT_PASSWORD=your_password_here

# Sure Finance REST API (https://finance.zeroinside.id/api/v1)
# X-Api-Key header value — create one in the Sure app settings.
SURE_API_KEY=your_sure_api_key_here
SURE_BASE_URL=https://finance.zeroinside.id/api/v1
